<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.odin2.ds4bridgehelper"
    android:versionCode="33"
    android:versionName="0.16.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:name=".BridgeApplication" android:label="Raven Gamepad"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher">
        <activity android:name=".PickerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".BridgeActivity" android:exported="false" />
        <activity android:name=".DiagnosticsActivity" android:exported="false" />
        <activity android:name=".MappingActivity" android:exported="false" />
        <activity android:name=".AppearanceActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <receiver android:name=".ExclusionReceiver" android:exported="true" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <provider android:name=".TargetsProvider"
            android:authorities="com.odin2.ds4bridgehelper.targets"
            android:exported="true"
            android:directBootAware="true" />
    </application>
</manifest>
